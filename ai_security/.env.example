# LLM Provider Configuration
# Supported: openai, google, anthropic
LLM_PROVIDER=openai

# API Key — REQUIRED for LLM explanations (fallback works without it)
LLM_API_KEY=

# Model name (optional — defaults to provider-specific model)
# OpenAI: gpt-4o-mini | Google: gemini-1.5-flash | Anthropic: claude-3-haiku-20240307
LLM_MODEL=

# Per-request timeout in seconds (default: 6, overall budget: 8)
LLM_TIMEOUT_SECONDS=6
